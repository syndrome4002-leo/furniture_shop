# Shopware Store API — required for build AND the browser cart.
# The access key is a public sales-channel credential, so NEXT_PUBLIC_ is correct.
NEXT_PUBLIC_SHOPWARE_URL=https://your-shop.shopware.store
NEXT_PUBLIC_SHOPWARE_ACCESS_KEY=YOUR_SALES_CHANNEL_ACCESS_KEY

# Strapi (optional during initial scaffold — falls back to mock data if unset)
STRAPI_URL=http://localhost:1337
STRAPI_TOKEN=

# Used by scripts/rebuild-server.js — Strapi sends this in the webhook headers
REBUILD_WEBHOOK_SECRET=change-me
